// Merge this match block into the existing Firestore rules.
// Do not deploy this fragment as the complete ruleset.
match /cookie_consents/{consentId} {
  allow create: if request.resource.data.keys().hasAll(['choice', 'submitted_at'])
    && request.resource.data.keys().hasOnly(['choice', 'submitted_at'])
    && request.resource.data.choice in ['essential', 'all']
    && request.resource.data.submitted_at == request.time;
  allow read: if request.auth != null;
  allow update, delete: if false;
}
